# Server Configuration
PORT=8080
FLASK_ENV=development

# Database Configuration
# For production (Heroku), DATABASE_URL is automatically set
# For local development, either set DATABASE_URL or use DB_USER/DB_NAME
DATABASE_URL=postgresql://localhost/mealbot
# DB_USER=johnamadeodaniswara
# DB_NAME=mealbot

# Auth0 Configuration (required for JWT verification)
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=your-api-audience
AUTH0_CLIENT_ID=your-client-id
AUTH0_ALGORITHMS=RS256

# Mailgun Configuration (required for email notifications)
MAILGUN_SMTP_LOGIN=your-smtp-login
MAILGUN_DOMAIN=your-mailgun-domain
MAILGUN_API_KEY=your-api-key
