# Mealbot Environment Configuration
# Copy this file to .env and fill in your values

# Server configuration
PORT=8080

# Database configuration (required)
# For local development with PostgreSQL:
#   DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/mealbot
# For production (Heroku sets this automatically):
#   DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname
DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/mealbot

# Mailgun configuration (optional - for email sending)
# MAILGUN_SMTP_LOGIN=postmaster@mg.yourdomain.com
# MAILGUN_DOMAIN=mg.yourdomain.com
# MAILGUN_API_KEY=your-mailgun-api-key

# Auth0 configuration (defaults are provided, override if needed)
# AUTH0_ISSUER=https://mealbot.auth0.com/
# AUTH0_AUDIENCE=https://mealbot-2.herokuapp.com/
# AUTH0_JWKS_URL=https://mealbot.auth0.com/.well-known/jwks.json
